    {
      "parameters": {
        "jsCode": "const rows = items.map(i => i.json);\nconst interested = rows.filter(r => String(r.estado).toLowerCase() === 'interesado');\nconst stuck = interested.filter(r => Number(r.mensajes_sin_respuesta || 0) > 0 || !r.nombre);\nconst list = stuck.map(r => `- ${r.nombre || '(sin nombre)'} | ${r.telefono} | ${r.contexto || ''}`).join('\\n');\nreturn [{ json: { total: stuck.length, lista: list || '(sin conversaciones para retomar)' } }];"
