    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst data = body.data ?? body;\nconst messageValue = data.message?.conversation ?? data.message?.extendedTextMessage?.text ?? data.text ?? (typeof data.message === 'string' ? data.message : '');\nconst mensaje = String(messageValue ?? '').trim();\nconst senderValue = data.key?.remoteJid ?? data.from ?? data.phone ?? '';\nconst telefono = String(senderValue).replace(/@s\\.whatsapp\\.net$/, '');\nconst esComando = mensaje.startsWith('//') || mensaje.startsWith('/');\nlet comando = 'desconocido';\nif (mensaje.startsWith('//clases')) comando = 'clases';\nelse if (mensaje.startsWith('/interesados')) comando = 'interesados';\nconst ruta = esComando ? 'comando' : 'mensaje';\nreturn [{ json: { ruta, comando, telefono, mensaje } }];"
      },
