    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst startOfWeek = new Date(now);\nstartOfWeek.setDate(now.getDate() - now.getDay());\nconst rows = items.map(i => i.json);\nconst trial = rows.filter(r => r.clase_prueba);\nconst thisWeek = trial.filter(r => new Date(r.clase_prueba) >= startOfWeek);\nconst pending = thisWeek.filter(r => String(r.recordatorio_enviado).toLowerCase() !== 'si');\nreturn pending.map(r => ({ json: { telefono: r.telefono, nombre: r.nombre || '', clase_prueba: r.clase_prueba } }));"
      },
