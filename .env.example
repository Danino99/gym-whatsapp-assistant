# Pin these to reviewed versions before running the local demo.
N8N_IMAGE=n8nio/n8n:REPLACE_WITH_PINNED_VERSION
EVOLUTION_API_IMAGE=atendai/evolution-api:REPLACE_WITH_PINNED_VERSION
POSTGRES_IMAGE=postgres:15-alpine
REDIS_IMAGE=redis:7-alpine

# Replace all secret placeholders with unique local test values.
AUTHENTICATION_API_KEY=REPLACE_WITH_LONG_RANDOM_VALUE
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
N8N_ENCRYPTION_KEY=REPLACE_WITH_LONG_RANDOM_VALUE

POSTGRES_USER=evolution_demo
POSTGRES_DB=evolution_demo
SERVER_PORT=8080
N8N_PORT=5678
TZ=America/Argentina/Buenos_Aires
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires
CONFIG_SESSION_PHONE_VERSION=REPLACE_WITH_REVIEWED_VERSION
